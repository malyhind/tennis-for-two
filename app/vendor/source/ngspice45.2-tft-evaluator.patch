+
+/* Research fast path: the function and its derivative trees share subtrees.
+ * Reuse a shared node only during ONE IFeval invocation. Input values, time,
+ * temperature and gmin are fixed for that invocation. No Newton/timepoint
+ * cache survives it. tmalloc() zero-initializes the fields on each new node.
+ * ngspice's parser already uses process-global state; this patch is scoped to
+ * the existing single-thread build. Stateful/private operators fall back.
+ */
+#if TFT_EVAL_MEMO
+static uint64_t tft_epoch;
+
+static int
+PTstateful(const INPparseNode *tree)
+{
+    if (!tree)
+        return 0;
+    if (tree->type == PT_FUNCTION &&
+        (tree->funcnum == PTF_DDT ||
+         (tree->data && tree->funcnum != PTF_PWL &&
+          tree->funcnum != PTF_PWL_DERIVATIVE)))
+        return 1;
+    return PTstateful(tree->left) || PTstateful(tree->right);
+}
+#endif
+
